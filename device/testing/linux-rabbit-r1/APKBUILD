4b57847c965ce608a17f6f24fe9811457a657187628f900a17bb97b191f16c072f21ecdf75fad6125ccd7187208f34959ea9e599e082817a1ad822de158ebf02  config-rabbit-r1.aarch64
6e84abe811dd3650767f9b89365e2babe1feb8fd1f810839efd5255d4c9eeb4a9caad83b5d5c4b988875a910dc4f38657713450ee2f10504e0ed75f68e08c1f4  0001-fix-cross-unit-inline-declarations.patch
